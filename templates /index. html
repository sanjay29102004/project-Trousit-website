<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Tamil Nadu Tourism</title>
<link rel="stylesheet" href="{{ url_for('static', filename='css/style.css') }}">
</head>
<body>

<header>
    <h2>TN Tourism</h2>
    <nav>
        <a href="/">Home</a>
        <a href="/destinations">Destinations</a>
        <a href="/booking">Booking</a>
        <a href="/login">Login</a>
        <a href="/register">Register</a>
    </nav>
</header>

<section class="hero">
    <div>
        <h1>Explore Tamil Nadu</h1>
        <p>Discover Culture, Heritage and Natural Beauty</p>
        <a href="/destinations" class="btn">Explore Now</a>
    </div>
</section>

<section class="section">
    <h2>Popular Tourist Destinations</h2>

    <div class="cards">
        {% for place in destinations %}
        <div class="card">
            <img src="{{ place.image }}" alt="{{ place.name }}">
            <h3>{{ place.name }}</h3>
            <p>{{ place.description }}</p>
            <a href="/booking" class="btn">Book Now</a>
        </div>
        {% endfor %}
    </div>
</section>

<footer>
    <p>© 2026 Tamil Nadu Tourism</p>
</footer>

</body>
</html>
